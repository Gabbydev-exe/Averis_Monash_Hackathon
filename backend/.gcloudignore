# Upload only the inputs required by this backend's Dockerfile.
# Keep this explicit: broad Git ignore rules must not omit Maven's pom.xml.
**
!Dockerfile
!.dockerignore
!pom.xml
!mvnw
!.mvn/
!.mvn/**
!src/
!src/**

# Local credentials are never source-build inputs, including under src/.
.env
.env.*
*.env
gha-creds-*.json
